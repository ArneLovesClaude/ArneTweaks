{
    "schemaVersion": 1,
    "id": "arnestyles",
    "version": "${version}",
    "name": "ArneTweaks",
    "description": "Alles-in-einem Client-Mod: über 1000 Texture-Styles, HUD-Editor für jede Anzeige (auch das Minecraft-HUD), Spotify, Fadenkreuz-Editor, Nametags, Animationen und FPS-Einstellungen – fast alles anpassbar.",
    "authors": [
        "Arne"
    ],
    "contact": {
        "homepage": "https://github.com/ArneLovesClaude/ArneTweaks",
        "sources": "https://github.com/ArneLovesClaude/ArneTweaks",
        "issues": "https://github.com/ArneLovesClaude/ArneTweaks/issues"
    },
    "license": "LicenseRef-All-Rights-Reserved",
    "icon": "assets/arnestyles/icon.png",
    "environment": "client",
    "entrypoints": {
        "main": [
            "com.arnestyles.ArneStyles"
        ],
        "client": [
            "com.arnestyles.client.ArneStylesClient"
        ],
        "modmenu": [
            "com.arnestyles.client.ArneModMenu"
        ]
    },
    "mixins": [
        {
            "config": "arnestyles.client.mixins.json",
            "environment": "client"
        }
    ],
    "suggests": {
        "modmenu": "*",
        "skyboxify": "*"
    },
    "depends": {
        "fabricloader": ">=0.18.4",
        "minecraft": "~1.21.11",
        "java": ">=21",
        "fabric-api": "*"
    }
}